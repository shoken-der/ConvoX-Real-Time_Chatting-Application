# ============================================================
# ConvoX — Root Environment Variables Example
# Copy this file, rename to .env, and fill in your own values.
# The .env file is git-ignored and must NEVER be committed.
# ============================================================

# Backend Database
DB_URL=jdbc:mysql://localhost:3306/convox_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD

# JWT Secret (min 64 characters)
JWT_SECRET=YOUR_JWT_SECRET_MIN_64_CHARS

# Mail (Gmail SMTP App Password)
MAIL_USERNAME=YOUR_GMAIL_ADDRESS@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Frontend API URL (used by React)
REACT_APP_API_URL=http://localhost:8080