{
  "name": "convox",
  "version": "1.0.0",
  "description": "ConvoX - Real-time Chat App migrated to Spring Boot",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && mvnw spring-boot:run",
    "frontend": "npm start --prefix frontend",
    "install-all": "npm install && npm install --prefix frontend",
    "build": "mvn -f backend/pom.xml clean package && npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
